FROM golang:1.22-alpine AS builder
RUN apk add --no-cache git ca-certificates
WORKDIR /app/services/graph
COPY services/graph/go.mod ./
RUN GOWORK=off go mod download
COPY services/graph/ ./
RUN GOWORK=off CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /service .

FROM alpine:latest
RUN apk add --no-cache ca-certificates
COPY --from=builder /service /service
COPY services/graph/graph.json /app/graph.json
WORKDIR /app
EXPOSE 8087
ENTRYPOINT ["/service"]
