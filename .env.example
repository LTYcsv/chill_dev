# Copy to .env and fill in values before running make dev / make up

# Auth service — HS256 JWT signing key
JWT_SECRET=change-me-in-production-please

# Deploy service — GitHub webhook HMAC secret (must match what you set in GitHub)
WEBHOOK_SECRET=change-me-webhook-secret

# Secrets service — AES-256-GCM key (exactly 32 bytes)
ENCRYPTION_KEY=12345678901234567890123456789012
